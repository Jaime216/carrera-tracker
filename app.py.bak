import streamlit as st
import pandas as pd
import plotly.graph_objects as go
import calendar
from datetime import datetime, date
import db

st.set_page_config(page_title="Control Académico", page_icon="🎓", layout="wide")
st.title("🎓 Control de Carrera Universitaria")

# ------------------------------------------------------------------------------
# 1. CARGA Y LIMPIEZA DE DATOS
# ------------------------------------------------------------------------------
try:
    df_asignaturas = db.get_table("Asignaturas")
    df_asistencia = db.get_table("Asistencia")
    df_notas = db.get_table("Calificaciones")
    try:
        df_horario = db.get_table("Horario")
    except:
        df_horario = pd.DataFrame() # Prevención por si la tabla está vacía
except Exception as e:
    st.error(f"❌ Error al conectar con Google Sheets: {e}")
    st.stop()

hay_asignaturas = False
mapa_asignaturas = {}
mapa_nombres_rev = {}
mapa_activas = {} # Solo las que NO están aprobadas

if not df_asistencia.empty:
    df_asistencia.columns = df_asistencia.columns.str.strip().str.lower()
    df_asistencia["fecha"] = pd.to_datetime(df_asistencia["fecha"], errors="coerce")
    # Compatibilidad hacia atrás
    if "tipo" not in df_asistencia.columns: df_asistencia["tipo"] = "Teoría"
    else: df_asistencia["tipo"] = df_asistencia["tipo"].fillna("Teoría").replace("", "Teoría")

if not df_notas.empty:
    df_notas.columns = df_notas.columns.str.strip().str.lower()
    df_notas["nota"] = pd.to_numeric(df_notas["nota"], errors="coerce")
    df_notas["ponderacion_pct"] = pd.to_numeric(df_notas["ponderacion_pct"], errors="coerce")
    df_notas["fecha"] = pd.to_datetime(df_notas["fecha"], errors="coerce")
    
    if "estado" not in df_notas.columns: df_notas["estado"] = "Realizado"
    else: df_notas["estado"] = df_notas["estado"].fillna("Realizado").replace("", "Realizado")
    
    # Compatibilidad hacia atrás
    if "tipo" not in df_notas.columns: df_notas["tipo"] = "Teoría"
    else: df_notas["tipo"] = df_notas["tipo"].fillna("Teoría").replace("", "Teoría")


# ------------------------------------------------------------------------------
# 2. PESTAÑAS DE LA APLICACIÓN
# ------------------------------------------------------------------------------
tab_dash, tab_horario, tab_asis, tab_eval, tab_asig = st.tabs([
    "📈 Dashboard", "🕒 Horario", "📝 Asistencia", "📊 Calificaciones", "📚 Asignaturas"
])

# ==============================================================================
# TAB 1: DASHBOARD
# ==============================================================================
with tab_dash:
    if not hay_asignaturas:
        st.info("Crea primero tus asignaturas en la pestaña **📚 Asignaturas**.")
    else:
        sub_graficos, sub_calendario = st.tabs(["📊 Gráficos y Métricas", "📅 Vista Calendario"])

        with sub_graficos:
            # CÁLCULOS PARA KPIs
            df_aprobadas = df_asignaturas[df_asignaturas["estado"] == "Aprobada"]
            creditos_conseguidos = df_aprobadas["creditos"].sum() if not df_aprobadas.empty else 0.0
            
            media_expediente = 0.0
            if creditos_conseguidos > 0:
                # Media ponderada universitaria (Suma de [Nota * Créditos] / Créditos Totales)
                suma_ponderada = (df_aprobadas["nota_final"] * df_aprobadas["creditos"]).sum()
                media_expediente = round(suma_ponderada / creditos_conseguidos, 2)

            st.subheader("Expediente Académico")
            kpi1, kpi2, kpi3, kpi4 = st.columns(4)
            
            kpi1.metric("📚 Asig. Cursando", len(df_asignaturas) - len(df_aprobadas))
            kpi2.metric("✅ Asig. Aprobadas", len(df_aprobadas))
            kpi3.metric("🏆 Créditos Superados", f"{creditos_conseguidos} ECTS")
            kpi4.metric("⭐ Media Expediente", media_expediente)

            st.divider()
            st.markdown("*(El resto de gráficos que tenías se mantienen aquí)*")
            # (Nota: He resumido los gráficos aquí por brevedad, no borres los que tenías si los copias y pegas por partes)

        with sub_calendario:
            st.info("Vista de calendario de eventos y exámenes (tu código anterior va aquí).")

# ==============================================================================
# TAB 2: HORARIO SEMANAL
# ==============================================================================
with tab_horario:
    st.subheader("🗓️ Horario de Clases (Asignaturas Activas)")
    
    if not mapa_activas:
        st.info("No tienes asignaturas 'En curso' para colocar en el horario.")
    else:
        # Formulario para añadir clases
        with st.expander("➕ Añadir clase al horario"):
            with st.form("form_horario", clear_on_submit=True):
                c1, c2, c3, c4 = st.columns(4)
                with c1:
                    h_asig = st.selectbox("Asignatura", list(mapa_activas.keys()))
                with c2:
                    h_dia = st.selectbox("Día", ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes"])
                with c3:
                    h_ini = st.time_input("Hora Inicio", value=pd.to_datetime("09:00").time())
                with c4:
                    h_fin = st.time_input("Hora Fin", value=pd.to_datetime("11:00").time())
                
                if st.form_submit_button("Añadir al horario", width="stretch"):
                    with st.spinner("Guardando..."):
                        db.add_horario(mapa_activas[h_asig], h_dia, h_ini.strftime("%H:%M"), h_fin.strftime("%H:%M"))
                        st.success("Clase añadida.")
                        st.rerun()

        st.divider()
        
        # Pintar el Horario Visual
        dias_semana = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes"]
        cols = st.columns(5)
        
        for i, dia in enumerate(dias_semana):
            with cols[i]:
                st.markdown(f"{dia}", unsafe_allow_html=True)
                
                if not df_horario.empty and "dia_semana" in df_horario.columns:
                    clases_dia = df_horario[df_horario["dia_semana"] == dia].sort_values("hora_inicio")
                    
                    for _, clase in clases_dia.iterrows():
                        id_asig = str(clase["id_asignatura"])
                        nom_asig = mapa_nombres_rev.get(id_asig, id_asig)
                        
                        # Si la asignatura ya está aprobada, la ponemos más transparente
                        es_aprobada = id_asig not in mapa_activas.values()
                        bg = "#F3F4F6" if es_aprobada else "#EEF2FF"
                        borde = "#9CA3AF" if es_aprobada else "#818CF8"
                        
                        st.markdown(
                            f"""
                            
                                {clase['hora_inicio']} - {clase['hora_fin']}
                                {nom_asig}
                            
                            """, unsafe_allow_html=True
                        )

# ==============================================================================
# TAB 5: ASIGNATURAS (CON OPCIÓN DE APROBAR)
# ==============================================================================
with tab_asig:
    col_crear, col_aprobar = st.columns(2)
    
    with col_crear:
        st.subheader("➕ Nueva Asignatura")
        # ... (Tu formulario de crear asignatura va aquí) ...

    with col_aprobar:
        st.subheader("🎓 Aprobar Asignatura")
        if not mapa_activas:
            st.info("No hay asignaturas pendientes de aprobar.")
        else:
            st.write("¡Enhorabuena! Marca una asignatura como superada para que sume a tus créditos y se bloquee del horario.")
            with st.form("form_aprobar"):
                asig_ap = st.selectbox("Asignatura superada", list(mapa_activas.keys()))
                nota_fin = st.number_input("Nota Definitiva (Acta)", min_value=5.0, max_value=10.0, step=0.1, value=5.0)
                
                if st.form_submit_button("🏆 Marcar como Aprobada", type="primary", width="stretch"):
                    with st.spinner("Actualizando expediente..."):
                        db.aprobar_asignatura(mapa_activas[asig_ap], nota_fin)
                        st.success(f"¡Asignatura superada con un {nota_fin}!")
                        st.rerun()
